<style>
@layer starlight.core {

/* ===============================
   Floating Dock Container
================================ */

.dock-footer {
  position: fixed;
  bottom: 20px;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  pointer-events: none;
  z-index: 9999;
}

/* ===============================
   Glass Bar
================================ */

/* ===============================
   Glass Bar — THEME AWARE
================================ */

/* DARK MODE */

:root[data-theme="dark"] .dock-menu {

  background: linear-gradient(
    135deg,
    rgba(30, 30, 60, 0.75),
    rgba(50, 30, 90, 0.75)
  );

  border: 1px solid rgba(255, 255, 255, 0.08);

  box-shadow:
    0 8px 30px rgba(0,0,0,0.45),
    0 0 20px rgba(160,120,255,0.25);
}


/* LIGHT MODE */
:root[data-theme="light"] .dock-menu {

  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.65),
    rgba(240, 240, 255, 0.65)
  );

  border: 1px solid rgba(0, 0, 0, 0.08);

  box-shadow:
    0 8px 30px rgba(0,0,0,0.15),
    0 0 20px rgba(120, 100, 255, 0.15);
}


/* Shared blur */
.dock-menu {
  pointer-events: auto;

  display: flex;
  gap: 0.6rem;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;

  padding: 0.7rem 1rem;
  border-radius: 18px;

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  max-width: calc(100% - 40px);
}

/* DARK hover */
:root[data-theme="dark"] .dock-item::before {
  background: linear-gradient(
    135deg,
    rgba(160,120,255,0.35),
    rgba(120,200,255,0.35)
  );
}

/* LIGHT hover */
:root[data-theme="light"] .dock-item::before {
  background: linear-gradient(
    135deg,
    rgba(124,58,237,0.25),
    rgba(99,102,241,0.25)
  );
}

/* ===============================
   Menu Items
================================ */

.dock-item {
  position: relative;

  padding: 0.55rem 1rem;
  border-radius: 12px;

  font-size: 0.9rem;
  font-weight: 500;
  letter-spacing: 0.3px;

  color: var(--sl-color-text);
  text-decoration: none;

  transition: all 0.25s ease;
}

/* Glow background */

.dock-item::before {
  content: "";
  position: absolute;
  inset: 0;

  border-radius: inherit;

  background: linear-gradient(
    135deg,
    rgba(160,120,255,0.35),
    rgba(120,200,255,0.35)
  );

  opacity: 0;
  transition: opacity 0.25s ease;
  z-index: -1;
}

/* Hover */

.dock-item:hover {
  transform: translateY(-2px) scale(1.05);
  color: white;
}

.dock-item:hover::before {
  opacity: 1;
}

/* Active press */

.dock-item:active {
  transform: translateY(0) scale(0.97);
}

/* ===============================
   Mobile Responsive
================================ */

@media (max-width: 700px) {

  .dock-menu {
    gap: 0.4rem;
    padding: 0.5rem 0.6rem;
  }

  .dock-item {
    font-size: 0.8rem;
    padding: 0.45rem 0.7rem;
  }

}

/* ===============================
   Safe Area for iOS
================================ */

@supports (padding: env(safe-area-inset-bottom)) {
  .dock-footer {
    bottom: calc(12px + env(safe-area-inset-bottom));
  }
}

}
</style>