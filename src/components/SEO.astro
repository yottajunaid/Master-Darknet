---
import { SEO } from "astro-seo";

const { title, description } = Astro.props;

const image =
  "https://yottajunaid.github.io/Master-Darknet/og.png";
---

<SEO
  title={title}
  description={description}
  canonical={Astro.url.href}
  titleTemplate="%s | Master Darknet"
  titleDefault="Master Darknet"
  openGraph={{
    basic: {
      title: title || "Master Darknet",
      type: "website",
      url: Astro.url.href
    }
    image: {
      url: image,
      alt: "Master Darknet",
      width: 1200,
      height: 630,
    }
  }}
  twitter={{
    card: "summary_large_image",
    image: image,
    title: title || "Master Darknet",
    description: description  
  }}
/>